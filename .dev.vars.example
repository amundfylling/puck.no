# Copy to .dev.vars for local development (git-ignored).
# .dev.vars is read by `wrangler pages dev` (functions env), NOT by the Astro
# build — the PUBLIC_ variable must also be set when building (see .env).
#
# For local dev, use Cloudflare's official always-pass TEST keys:
#   https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Same value as PUBLIC_TURNSTILE_SITE_KEY, kept for reference:
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Required for /api/admin/*: Cloudflare Access team name/domain and the
# application's Audience (AUD) tag. The API fails closed when either is absent
# and cryptographically verifies Cf-Access-Jwt-Assertion on every request.
# ACCESS_TEAM_NAME=your-team
# ACCESS_POLICY_AUD=copy-from-access-application-additional-settings

# Optional: GitHub token (repo scope) for POST /api/admin/registration-open —
# the admin portal's open/close-registration button commits the frontmatter
# change via the GitHub API. Without it the endpoint returns 503.
# GITHUB_TOKEN=ghp_...
