{
  "serverInfo": {
    "name": "puck-no-admin-remote",
    "version": "1.0.0",
    "description": "Authorized NBHF administration tools for tournaments, registrations, content and deployment status."
  },
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://www.puck.no/mcp"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.puck.no/mcp",
      "authentication": {
        "type": "oauth2",
        "protectedResourceMetadata": "https://www.puck.no/.well-known/oauth-protected-resource"
      }
    }
  ],
  "supportedProtocolVersions": [
    "2025-06-18",
    "2025-03-26",
    "2024-11-05"
  ],
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  }
}
