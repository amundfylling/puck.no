---
import '../styles/global.css';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/geist';

interface Props {
  /** Full <title> text. */
  title: string;
  /** Visible page heading in the top bar. */
  heading: string;
  /** Which sidebar item is active. */
  active: 'oversikt' | 'pameldinger';
}

const { title, heading, active } = Astro.props;

const navItems = [
  {
    id: 'oversikt' as const,
    href: '/admin/',
    label: 'Oversikt',
    icon: 'M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z',
  },
  {
    id: 'pameldinger' as const,
    href: '/admin/pameldinger/',
    label: 'Påmeldinger',
    icon: 'M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z',
  },
];
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline defer src="/js/scroll-regions.js"></script>
    <script is:inline>
      // Apply the saved theme before first paint (no flash). Default: system.
      try {
        const stored = localStorage.getItem('admin-theme');
        if (
          stored === 'dark' ||
          (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        }
      } catch {}
    </script>
  </head>
  <body>
    <a href="#admin-content" class="skip-link">Hopp til hovedinnhold</a>
    <div class="flex min-h-screen">
      <!-- Sidebar: static on desktop, slide-over drawer on mobile -->
      <div
        data-drawer-backdrop
        class="fixed inset-0 z-30 hidden bg-navy-dark/60 backdrop-blur-sm lg:hidden"
      >
      </div>
      <aside
        id="admin-drawer"
        data-drawer
        class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col bg-navy-dark text-slate-300 transition-transform duration-200 lg:static lg:translate-x-0 dark:bg-slate-900 dark:ring-1 dark:ring-slate-800"
      >
        <div class="flex h-16 items-center gap-3 px-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand font-display text-sm font-extrabold text-white">N</span>
          <div class="leading-tight">
            <p class="font-display font-bold text-white">Bordhockey&shy;forbundet</p>
            <p class="text-xs text-slate-400">Adminportal</p>
          </div>
          <button
            type="button"
            data-drawer-close
            class="ml-auto flex h-11 w-11 items-center justify-center rounded-md text-slate-400 hover:bg-white/10 hover:text-white lg:hidden"
            aria-label="Lukk meny"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 18 18 6M6 6l12 12" /></svg>
          </button>
        </div>
        <nav class="mt-2 flex-1 space-y-1 px-3" aria-label="Admin">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={active === item.id ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center gap-3 rounded-lg px-3 py-2 text-sm font-semibold transition-colors',
                  active === item.id
                    ? 'bg-brand text-white'
                    : 'text-slate-300 hover:bg-white/10 hover:text-white',
                ]}
              >
                <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon} /></svg>
                {item.label}
              </a>
            ))
          }
          <div class="pt-4">
            <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Innhold</p>
            <a
              href="/admin/cms/"
              class="flex min-h-11 items-center gap-3 rounded-lg px-3 py-2 text-sm font-semibold text-slate-300 transition-colors hover:bg-white/10 hover:text-white"
            >
              <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
              Rediger innhold (CMS)
            </a>
          </div>
        </nav>
        <div class="border-t border-white/10 p-3">
          <a
            href="/"
            class="flex min-h-11 items-center gap-3 rounded-lg px-3 py-2 text-sm font-semibold text-slate-300 transition-colors hover:bg-white/10 hover:text-white"
          >
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
            Til nettsiden
          </a>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-20 flex h-16 items-center gap-3 border-b border-slate-200 bg-white/85 px-4 backdrop-blur sm:px-6 dark:border-slate-800 dark:bg-slate-950/85">
          <button
            type="button"
            data-drawer-open
            aria-controls="admin-drawer"
            aria-expanded="false"
            class="flex h-11 w-11 items-center justify-center rounded-md text-slate-500 hover:bg-slate-100 lg:hidden dark:text-slate-400 dark:hover:bg-slate-800"
            aria-label="Åpne meny"
          >
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
          </button>
          <h1 class="truncate font-display text-xl font-bold text-navy dark:text-white">{heading}</h1>
          <button
            type="button"
            data-theme-toggle
            class="ml-auto flex h-11 w-11 items-center justify-center rounded-lg border border-slate-200 text-slate-500 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
            aria-label="Bytt mellom lyst og mørkt tema"
          >
            <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" /></svg>
            <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>
          </button>
        </header>
        <main id="admin-content" tabindex="-1" class="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-8">
          <slot />
        </main>
      </div>
    </div>

    <script>
      // Theme toggle (persisted) + mobile drawer.
      for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
        btn.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem('admin-theme', dark ? 'dark' : 'light');
          } catch {}
        });
      }
      const drawer = document.querySelector<HTMLElement>('[data-drawer]');
      const backdrop = document.querySelector<HTMLElement>('[data-drawer-backdrop]');
      const openButton = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
      const closeButton = document.querySelector<HTMLButtonElement>('[data-drawer-close]');
      const desktop = window.matchMedia('(min-width: 1024px)');
      let drawerOpen = false;

      const syncDrawerAccessibility = () => {
        const hiddenOnMobile = !desktop.matches && !drawerOpen;
        drawer?.toggleAttribute('inert', hiddenOnMobile);
        drawer?.setAttribute('aria-hidden', String(hiddenOnMobile));
        openButton?.setAttribute('aria-expanded', String(drawerOpen));
      };
      const setOpen = (open: boolean, restoreFocus = false) => {
        drawerOpen = open;
        drawer?.classList.toggle('-translate-x-full', !open);
        backdrop?.classList.toggle('hidden', !open);
        document.body.classList.toggle('overflow-hidden', open && !desktop.matches);
        syncDrawerAccessibility();
        if (open) closeButton?.focus();
        else if (restoreFocus) openButton?.focus();
      };
      openButton?.addEventListener('click', () => setOpen(true));
      closeButton?.addEventListener('click', () => setOpen(false, true));
      backdrop?.addEventListener('click', () => setOpen(false, true));
      document.addEventListener('keydown', (event) => {
        if (!drawerOpen || desktop.matches) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          setOpen(false, true);
          return;
        }
        if (event.key !== 'Tab' || !drawer) return;
        const focusable = Array.from(
          drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'),
        );
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
      desktop.addEventListener('change', () => {
        if (desktop.matches) {
          drawerOpen = false;
          backdrop?.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        } else {
          drawer?.classList.add('-translate-x-full');
        }
        syncDrawerAccessibility();
      });
      syncDrawerAccessibility();
    </script>
  </body>
</html>
