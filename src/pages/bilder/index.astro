---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryIndex from '../../components/GalleryIndex.astro';
import { getEntry } from 'astro:content';
import { seoForContent } from '../../lib/seo';
import { assertDedicatedBodyUnchanged } from '../../lib/dedicated-body';

const entry = await getEntry('pages', 'bilder');
if (!entry) throw new Error('pages/bilder not found');
assertDedicatedBodyUnchanged(entry.id);
const seo = seoForContent('/bilder', entry.data);
---

<BaseLayout
  lang="no"
  title={seo.title}
  description={seo.description}
  canonicalPath="/bilder"
  noUrl="/bilder"
  enUrl="/en/bilder"
>
  <section class="page-shell">
    <h1 class="page-title">{entry.data.title}</h1>
    {entry.data.description && <p class="page-lead">{entry.data.description}</p>}
    <GalleryIndex lang="no" />
  </section>
</BaseLayout>
