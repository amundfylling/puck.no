---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrickDetail from '../../../components/TrickDetail.astro';
import { publicIllustration } from '../../../lib/illustrations';
import { trickPath } from '../../../lib/tricks';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const tricks = await getCollection('tricks');
  const illustrations = await getCollection('illustrations');
  const illustrationMap = new Map(illustrations.map((entry) => [entry.data.slug, entry]));
  return tricks.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      tricks,
      illustration: publicIllustration(
        entry.data.illustration ? illustrationMap.get(entry.data.illustration) : undefined,
        entry.data.diagram,
      ),
    },
  }));
}) satisfies GetStaticPaths;

const { entry, tricks, illustration } = Astro.props;
const { data } = entry;
const path = trickPath(data.slug, 'en');
const title = `${data.name} – table hockey combination | Bordhockeyforbundet`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: data.name,
  description: data.description.en,
  url: `https://www.puck.no${path}`,
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'Table hockey combinations',
    url: 'https://www.puck.no/en/lær-bordhockey-kombinasjoner/',
  },
};
---

<BaseLayout
  lang="en"
  title={title}
  description={data.description.en}
  canonicalPath={path}
  noUrl={trickPath(data.slug, 'no')}
  enUrl={path}
  ogImage={data.diagram}
  jsonLd={jsonLd}
>
  <TrickDetail entry={entry} entries={tricks} illustration={illustration} lang="en" />
</BaseLayout>
