---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrickCatalogue from '../../components/TrickCatalogue.astro';
import TrickGuide from '../../components/TrickGuide.astro';
import { seoForContent } from '../../lib/seo';

const page = (await getCollection('pages')).find(
  (entry) => entry.data.lang === 'en' && entry.data.slug === 'lær-bordhockey-kombinasjoner',
);
if (!page) throw new Error('Missing English combinations page');
const tricks = await getCollection('tricks');
const illustrations = tricks.filter((entry) => entry.data.diagram).length;
const { Content } = await render(page);
const path = '/en/lær-bordhockey-kombinasjoner';
const seo = seoForContent(path, page.data);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: page.data.title,
  description: page.data.description,
  url: `https://www.puck.no${path}/`,
  numberOfItems: tricks.length,
  inLanguage: 'en',
};
---

<BaseLayout
  lang="en"
  title={seo.title}
  description={seo.description}
  canonicalPath={path}
  noUrl={path.replace(/^\/en/, '')}
  enUrl={path}
  jsonLd={jsonLd}
>
  <header class="border-b border-slate-200 bg-ice">
    <div class="mx-auto max-w-6xl px-4 py-7 sm:px-6 sm:py-9">
      <p class="text-sm font-semibold text-brand">Learn table hockey</p>
      <h1 class="mt-1 max-w-4xl text-3xl font-extrabold text-navy sm:text-4xl">{page.data.title}</h1>
      <div class="mt-3 flex flex-col gap-2 text-slate-700 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-6">
        <p>Find the name of a move, understand the motion and choose what to practise.</p>
        <p class="text-sm font-semibold text-navy tabular-nums">{tricks.length} combinations · {illustrations} illustrations</p>
      </div>
      <TrickGuide lang="en"><Content /></TrickGuide>
    </div>
  </header>

  <TrickCatalogue entries={tricks} lang="en" />
</BaseLayout>
