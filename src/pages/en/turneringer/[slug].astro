---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RegistrationForm from '../../../components/RegistrationForm.astro';
import ParticipantList from '../../../components/ParticipantList.astro';
import TournamentFacts from '../../../components/TournamentFacts.astro';
import TournamentResults from '../../../components/TournamentResults.astro';
import { tournamentImage, tournamentStatus } from '../../../lib/content';
import { formatIsoDate, formatNoDate, parseNoDate } from '../../../lib/dates';
import { seoForContent } from '../../../lib/seo';
import { t } from '../../../lib/i18n';
import { getPublicImageDimensions } from '../../../lib/media';
import registrations from '../../../data/registrations-snapshot.json';
import type { GetStaticPaths } from 'astro';

interface Player {
  name: string;
  country: string;
  world_ranking?: string;
}

export const getStaticPaths = (async () => {
  const tournaments = await getCollection('tournaments', (t) => !t.data.draft && t.data.lang === 'en');
  return tournaments.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const status = tournamentStatus(entry);
const registrationOpen = status === 'upcoming' && entry.data.registrationOpen;
const hero = tournamentImage(entry);
const heroDimensions = await getPublicImageDimensions(hero);
const date = parseNoDate(entry.data.date);
const isoDate = date ? formatIsoDate(date) : undefined;
const path = `/en/turneringer/${entry.data.slug}`;
const seo = seoForContent(path, {
  title: `${entry.data.name} | Bordhockeyforbundet`,
});
const players =
  (registrations.tournaments as Record<string, Player[]>)[entry.data.slug]?.filter(
    (p) => p.name && p.name.toLowerCase() !== 'name',
  ) ?? [];
const priceList = entry.data.prices?.split(';').map((s) => s.trim()).filter(Boolean) ?? [];
const noMirror = (await getCollection('tournaments', (t) => !t.data.draft && t.data.lang === 'no'))
  .find((t) => t.data.slug === entry.data.slug);
const registrationQuestions = noMirror?.data.registrationQuestions ?? entry.data.registrationQuestions;
const results = noMirror?.data.results ?? entry.data.results;

const allTournaments = await getCollection('tournaments', (t) => !t.data.draft && t.data.lang === 'en');
const parentEntry = entry.data.parent
  ? allTournaments.find((t) => t.data.slug === entry.data.parent)
  : null;
const childrenEntries = allTournaments
  .filter((t) => t.data.parent === entry.data.slug)
  .sort((a, b) => (parseNoDate(a.data.date)?.getTime() ?? 0) - (parseNoDate(b.data.date)?.getTime() ?? 0));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: entry.data.name,
  url: `https://www.puck.no${path}/`,
  ...(isoDate && { startDate: isoDate }),
  eventStatus:
    status === 'past' ? 'https://schema.org/EventCompleted' : 'https://schema.org/EventScheduled',
  ...(entry.data.location && {
    location: {
      '@type': 'Place',
      name: entry.data.location,
      address: { '@type': 'PostalAddress', addressCountry: 'NO' },
    },
  }),
  organizer: {
    '@type': 'SportsOrganization',
    name: 'Norwegian Table Hockey Association',
    url: 'https://www.puck.no/en/',
  },
  ...(parentEntry && {
    superEvent: {
      '@type': 'SportsEvent',
      name: parentEntry.data.name,
      url: `https://www.puck.no/en/turneringer/${parentEntry.data.slug}/`,
    },
  }),
  ...(childrenEntries.length > 0 && {
    subEvent: childrenEntries.map((child) => ({
      '@type': 'SportsEvent',
      name: child.data.name,
      url: `https://www.puck.no/en/turneringer/${child.data.slug}/`,
    })),
  }),
};
---

<BaseLayout
  lang="en"
  title={seo.title}
  description={seo.description}
  canonicalPath={path}
  noUrl={path.replace(/^\/en/, '')}
  enUrl={path}
  ogImage={hero}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <p class="text-sm">
      <a href="/en/turneringer/" class="inline-flex items-center min-h-[44px] font-semibold text-brand no-underline hover:underline"
        >&larr; {t('en', 'tournaments')}</a
      >
    </p>

    <header class="mt-3 border-b border-slate-200 pb-6 sm:pb-8">
      <h1 class="max-w-4xl text-3xl font-extrabold text-navy sm:text-4xl lg:text-5xl">{entry.data.name}</h1>
      <p class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-navy">
        <span
          class:list={[
            'h-2 w-2 rounded-full',
            status === 'upcoming' ? 'bg-green-500' : 'bg-slate-400',
          ]}
          aria-hidden="true"></span>
        {t('en', status)}
      </p>
    </header>

    {
      hero && (
        <figure class="mt-6 sm:mt-8">
          <img
            src={hero}
            alt={entry.data.name}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width={heroDimensions?.width}
            height={heroDimensions?.height}
            class="aspect-[16/7] w-full rounded-lg object-cover"
          />
        </figure>
      )
    }

    <nav aria-label={t('en', 'onThisPage')} class="mt-6 flex flex-wrap items-center gap-x-6 border-y border-slate-200 py-2">
      <span class="w-full py-2 text-sm font-semibold text-navy sm:w-auto">{t('en', 'onThisPage')}</span>
      <a href="#overview" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand no-underline hover:underline">
        {t('en', 'overview')}
      </a>
      <a href="#schedule" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand no-underline hover:underline">
        {t('en', 'schedule')}
      </a>
      {
        results && (
          <a href="#results" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand no-underline hover:underline">
            {t('en', 'results')}
          </a>
        )
      }
      {
        registrationOpen && (
          <a href="#registration" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand no-underline hover:underline">
            {t('en', 'registration')}
          </a>
        )
      }
      <a href="#participants" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand no-underline hover:underline">
        {t('en', 'registeredPlayers')}
      </a>
    </nav>

    <div id="overview" class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14">
      <TournamentFacts
        entry={entry}
        lang="en"
        parentEntry={parentEntry}
        priceList={priceList}
        isoDate={isoDate}
        registrationOpen={registrationOpen}
      />

      <div class:list={['rich-text tournament-body min-w-0 lg:order-1', hero && 'hide-first-image']}>
        {
          childrenEntries.length > 0 && (
            <section class="mb-8 border-y border-slate-200 py-4" aria-labelledby="tournament-classes">
              <h2 id="tournament-classes" class="text-lg font-bold text-navy">{t('en', 'classes')}</h2>
              <div class="mt-2 border-t border-slate-200">
                {childrenEntries.map((child) => {
                  const childStatus = tournamentStatus(child);
                  return (
                    <a
                      href={`/en/turneringer/${child.data.slug}/`}
                      class="group grid min-h-11 grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-2.5 border-b border-slate-100 py-2 no-underline last:border-b-0 hover:bg-ice/50"
                    >
                      <span
                        class:list={[
                          'h-2 w-2 shrink-0 rounded-full',
                          childStatus === 'upcoming' ? 'bg-green-500' : 'bg-slate-300',
                        ]}
                        aria-hidden="true"
                      />
                      <span class="font-semibold text-navy group-hover:underline">{child.data.name}</span>
                      <time datetime={parseNoDate(child.data.date) ? formatIsoDate(parseNoDate(child.data.date)!) : undefined} class="text-[13px] tabular-nums text-slate-600">
                        {formatNoDate(child.data.date, 'en')}
                      </time>
                    </a>
                  );
                })}
              </div>
            </section>
          )
        }
        <Content />
      </div>

    </div>

    {results && <TournamentResults results={results} lang="en" slug={entry.data.slug} />}

    {
      registrationOpen && (
        <RegistrationForm
          lang="en"
          slug={entry.data.slug}
          playersPerTeam={entry.data.playersPerTeam}
          maxSubstitutes={entry.data.maxSubstitutes}
          registrationQuestions={registrationQuestions}
        />
      )
    }

    <div id="participants">
      <ParticipantList
        slug={entry.data.slug}
        players={players}
        lang="en"
        playersPerTeam={entry.data.playersPerTeam}
        snapshotDate={registrations.snapshot_date}
      />
    </div>
  </article>
</BaseLayout>
