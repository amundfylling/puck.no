---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TournamentList from '../../components/TournamentList.astro';
import { getEntry } from 'astro:content';
import { getTournamentsSorted } from '../../lib/content';
import { seoForContent } from '../../lib/seo';
import { assertDedicatedBodyUnchanged } from '../../lib/dedicated-body';

const entry = await getEntry('pages', 'turneringer');
if (!entry) throw new Error('pages/turneringer not found');
assertDedicatedBodyUnchanged(entry.id);
const views = await getTournamentsSorted();
const seo = seoForContent('/turneringer', entry.data);
---

<BaseLayout
  lang="no"
  title={seo.title}
  description={seo.description}
  canonicalPath="/turneringer"
  noUrl="/turneringer"
  enUrl="/en/turneringer"
>
  <TournamentList lang="no" views={views} title={entry.data.title} description={entry.data.description} />
</BaseLayout>
