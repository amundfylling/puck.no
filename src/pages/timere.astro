---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { timerIntroParagraphs, timers } from '../lib/timere';
import { seoForContent } from '../lib/seo';

const entry = await getEntry('pages', 'timere');
if (!entry) throw new Error('pages/timere not found');
const intro = timerIntroParagraphs(entry.body ?? '');
const seo = seoForContent('/timere', entry.data);
---

<BaseLayout
  lang="no"
  title={seo.title}
  description={seo.description}
  canonicalPath="/timere"
  noUrl="/timere"
  enUrl="/en/timere"
>
  <section class="page-shell">
    <div class="max-w-3xl">
      <h1 class="page-title">{entry.data.title}</h1>
      {intro.map((p) => <p class="mt-4 leading-relaxed text-slate-700">{p}</p>)}
      <div class="mt-8 border-t border-slate-200">
        {timers.map((timer) => <AudioPlayer title={timer.title} file={timer.file} durationHint={timer.duration_hint} lang="no" />)}
      </div>
    </div>
  </section>
</BaseLayout>
