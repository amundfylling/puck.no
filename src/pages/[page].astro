---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arsmoter from '../components/Arsmoter.astro';
import QualificationStandings from '../components/QualificationStandings.astro';
import { pageMirrorsNoToEn, pagePath, renamedPages } from '../lib/i18n';
import { seoForContent } from '../lib/seo';
import type { GetStaticPaths } from 'astro';

/** Pages with dedicated templates (excluded here). */
export const getStaticPaths = (async () => {
  const SPECIAL = new Set(['index', 'blog', 'turneringer', 'timere', 'bilder', 'lær-bordhockey-kombinasjoner']);
  const pages = await getCollection('pages', (p) => p.data.lang === 'no' && !SPECIAL.has(p.data.slug));
  return pages.map((entry) => ({
    params: { page: renamedPages[entry.data.slug] ?? entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/${Astro.params.page}`;
const seo = seoForContent(path, entry.data);
---

<BaseLayout
  lang="no"
  title={seo.title}
  description={seo.description}
  canonicalPath={path}
  noUrl={pagePath(entry.data.slug, 'no')}
  enUrl={pagePath(pageMirrorsNoToEn[entry.data.slug] ?? entry.data.slug, 'en')}
>
  <article class="page-shell">
    <h1 class="page-title max-w-3xl">{entry.data.title}</h1>
    <div class="mt-8 max-w-4xl">
    {
      entry.data.slug === 'årsmøter' ? (
        <Arsmoter lang="no" />
      ) : entry.data.slug === 'kvalifisering-mesterskap' ? (
        <>
          <div class="rich-text flow-root mb-8">
            <Content />
          </div>
          <QualificationStandings lang="no" />
        </>
      ) : (
        <div class="rich-text flow-root">
          <Content />
        </div>
      )
    }
    </div>
  </article>
</BaseLayout>
