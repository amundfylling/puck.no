---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrickCatalogue from '../components/TrickCatalogue.astro';
import TrickGuide from '../components/TrickGuide.astro';
import { seoForContent } from '../lib/seo';

const page = (await getCollection('pages')).find(
  (entry) => entry.data.lang === 'no' && entry.data.slug === 'lær-bordhockey-kombinasjoner',
);
if (!page) throw new Error('Missing Norwegian combinations page');
const tricks = await getCollection('tricks');
const illustrationEntries = await getCollection('illustrations');
const illustrations = tricks.filter((entry) => entry.data.illustration || entry.data.diagram).length;
const { Content } = await render(page);
const path = '/lær-bordhockey-kombinasjoner';
const seo = seoForContent(path, page.data);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: page.data.title,
  description: page.data.description,
  url: `https://www.puck.no${path}/`,
  numberOfItems: tricks.length,
  inLanguage: 'no',
};
---

<BaseLayout
  lang="no"
  title={seo.title}
  description={seo.description}
  canonicalPath={path}
  noUrl={path}
  enUrl={`/en${path}`}
  jsonLd={jsonLd}
>
  <header>
    <div class="mx-auto max-w-6xl px-4 pt-10 pb-8 sm:pt-14">
      <p class="text-sm"><a href="/lær-bordhockey/" class="inline-flex min-h-11 items-center font-semibold text-brand no-underline hover:underline">&larr; Lær bordhockey</a></p>
      <h1 class="mt-1 max-w-4xl page-title">{page.data.title}</h1>
      <div class="mt-3 flex flex-col gap-2 text-slate-700 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-6">
        <p>Finn navnet på trekket, forstå bevegelsen og velg hva du vil øve på.</p>
        <p class="text-sm font-semibold text-navy tabular-nums">{tricks.length} kombinasjoner · {illustrations} illustrasjoner</p>
      </div>
      <TrickGuide lang="no"><Content /></TrickGuide>
    </div>
  </header>

  <TrickCatalogue entries={tricks} illustrations={illustrationEntries} lang="no" />
</BaseLayout>
