---
import { getImage } from 'astro:assets';
import hero from '../assets/images/hero.png';
import ScrollPhotoPlayer from './ScrollPhotoPlayer';

interface Props { alt: string }
const { alt } = Astro.props;
const widths = [480, 768, 1024, 1280, 1600];
const images = await Promise.all(widths.map((width) => getImage({ src: hero, width, format: 'webp' })));
const photo = {
  src: images[images.length - 1].src,
  srcSet: images.map((image, i) => `${image.src} ${widths[i]}w`).join(', '),
  sizes: '(min-width: 1152px) 1120px, calc(100vw - 2rem)',
  width: hero.width,
  height: hero.height,
};
---

<div class="photo-track mx-auto max-w-6xl px-4" data-photo-track>
  <div class="photo-stage" data-photo-stage>
    <img src={photo.src} width={photo.width} height={photo.height} sizes={photo.sizes} srcset={photo.srcSet} alt={alt} loading="eager" fetchpriority="high" class="photo-poster" />
    <div class="photo-motion" aria-hidden="true">
      <ScrollPhotoPlayer {...photo} client:media="(prefers-reduced-motion: no-preference)" />
    </div>
  </div>
</div>

<style>
  .photo-track::after { content: ""; display: block; height: 0; }
  .photo-stage { position: relative; overflow: hidden; }
  .photo-poster { display: block; width: 100%; height: auto; }
  .photo-motion { position: absolute; inset: 0; pointer-events: none; }
  /* Reserve the short scroll runway before hydration, but never without JS. */
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    .photo-track::after { height: 22svh; }
    .photo-stage { position: sticky; top: 6rem; }
    @media (min-width: 768px) and (min-height: 700px) {
      .photo-track::after { height: 42svh; }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-motion { display: none; }
  }
</style>
