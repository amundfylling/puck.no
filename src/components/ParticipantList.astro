---
import { t, type Lang } from '../lib/i18n';

interface Player {
  name: string;
  country: string;
  club?: string;
  world_ranking?: string;
  ranking_points?: number;
}

interface Props {
  slug: string;
  players: Player[];
  lang: Lang;
  playersPerTeam?: number | null;
  snapshotDate?: string;
}

const { slug, players, lang, playersPerTeam = null, snapshotDate } = Astro.props;
const isTeam = playersPerTeam != null;
const snapshotDisplay = snapshotDate
  ? new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'nb-NO', {
      dateStyle: 'medium',
      timeZone: 'UTC',
    }).format(new Date(`${snapshotDate}T12:00:00Z`))
  : null;
const labels = lang === 'en'
  ? {
      club: 'Club', points: 'Points', team: 'Team', substitute: 'Substitute', refreshed: 'Ranking updated',
      noParticipants: 'No participants are registered yet.',
      participantsCaption: 'Registered participants and their current ranking details.',
      placementCaption: 'Calculated ITHF points by finishing position.',
      liveUnavailable: 'Live updates are temporarily unavailable. The displayed list may be outdated.',
      snapshotFallback: snapshotDisplay
        ? `Live updates are unavailable. Showing the saved snapshot from ${snapshotDisplay}; it may be outdated.`
        : 'Live updates are unavailable. Showing a saved snapshot that may be outdated.',
      placementHeading: 'Calculated ITHF points by placement', placement: 'Placement', award: 'ITHF points',
      calculationNote: 'Calculated with the ITHF World Ranking 2020 algorithm from the current entrants and their Player Value.',
      emptyPoints: 'Points will be calculated when participants register.',
      fewerThanFour: 'Fewer than four participants gives no ranking points.',
      teamNoPoints: 'Level 10 team competitions do not give world-ranking points.',
      incomplete: 'One or more ranked players are awaiting a Player Value refresh, so these values may increase.',
    }
  : {
      club: 'Klubb', points: 'Poeng', team: 'Lag', substitute: 'Innbytter', refreshed: 'Ranking oppdatert',
      noParticipants: 'Ingen deltakere er påmeldt ennå.',
      participantsCaption: 'Påmeldte deltakere og gjeldende rankingopplysninger.',
      placementCaption: 'Beregnede ITHF-poeng etter sluttplassering.',
      liveUnavailable: 'Direkteoppdateringen er midlertidig utilgjengelig. Listen kan være utdatert.',
      snapshotFallback: snapshotDisplay
        ? `Direkteoppdateringen er utilgjengelig. Viser lagret oversikt fra ${snapshotDisplay}; den kan være utdatert.`
        : 'Direkteoppdateringen er utilgjengelig. Viser en lagret oversikt som kan være utdatert.',
      placementHeading: 'Beregnede ITHF-poeng per plassering', placement: 'Plassering', award: 'ITHF-poeng',
      calculationNote: 'Beregnet med ITHF World Ranking 2020-algoritmen fra dagens påmeldte og deres Player Value.',
      emptyPoints: 'Poengene beregnes når deltakere melder seg på.',
      fewerThanFour: 'Færre enn fire deltakere gir ingen rankingpoeng.',
      teamNoPoints: 'Lagturneringer på nivå 10 gir ingen verdensrankingpoeng.',
      incomplete: 'Én eller flere rangerte spillere venter på oppdatert Player Value, så poengene kan øke.',
    };
const legacyRoster = (name: string) => name.split(/\s+\/\s+|\s*,\s*/).map((part) => part.trim()).filter(Boolean);
const participantMeta = (player: Player) => [
  player.club,
  player.country,
  `WR ${player.world_ranking ?? '–'}`,
  `${labels.points}: ${player.ranking_points ?? '–'}`,
].filter(Boolean).join(' · ');
---

<section
  aria-labelledby="registered-players"
  class="mt-14 border-t border-slate-200 pt-10 sm:mt-16 sm:pt-12"
  data-participants
  data-slug={slug}
  data-team={String(isTeam)}
  data-players-per-team={playersPerTeam ?? ''}
  data-lang={lang}
  data-labels={JSON.stringify(labels)}
>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="registered-players" class="text-2xl font-bold text-navy">
      {t(lang, 'registeredPlayers')} <span data-participant-count class="text-lg font-semibold text-slate-500">({players.length})</span>
    </h2>
    <p class="text-xs text-slate-500" data-ranking-refreshed aria-live="polite"></p>
  </div>
  <p class="mt-3 hidden text-xs font-medium text-amber-800" data-participants-status role="status" aria-live="polite"></p>
  <p data-participant-empty class:list={['mt-4 border-y border-dashed border-slate-300 py-5 text-sm text-slate-600', players.length > 0 && 'hidden']}>
    {labels.noParticipants}
  </p>
  <div data-participant-mobile class:list={['mt-4 border-y border-slate-200 md:hidden', players.length === 0 && 'hidden']}>
    <ol data-participant-mobile-rows class="divide-y divide-slate-200" aria-label={labels.participantsCaption}>
      {
        isTeam
          ? players.map((team, teamIndex) => (
              <li class="py-4">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-semibold text-navy">{labels.team} {teamIndex + 1}</h3>
                  <span class="shrink-0 text-xs tabular-nums text-slate-600">{labels.points}: {team.ranking_points ?? '–'}</span>
                </div>
                <ul class="mt-2 divide-y divide-slate-100">
                  {legacyRoster(team.name).map((name, playerIndex) => (
                    <li class="py-2 text-sm">
                      <span class="font-medium text-navy">{name}</span>
                      {playerIndex >= playersPerTeam! && <span class="ml-2 text-xs text-slate-500">({labels.substitute})</span>}
                    </li>
                  ))}
                </ul>
              </li>
            ))
          : players.map((player, index) => (
              <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 py-3">
                <span class="pt-0.5 text-sm tabular-nums text-slate-500" aria-hidden="true">{index + 1}</span>
                <div class="min-w-0">
                  <p class="font-medium text-navy">{player.name}</p>
                  <p class="mt-1 break-words text-xs leading-5 text-slate-600">{participantMeta(player)}</p>
                </div>
              </li>
            ))
      }
    </ol>
  </div>
  <div data-participant-table class:list={['scroll-region mt-4 hidden border-y border-slate-200', players.length > 0 && 'md:block']} role="region" aria-label={labels.participantsCaption} tabindex="0">
    <table class="w-full min-w-[40rem] border-collapse text-sm">
      <caption class="sr-only">{labels.participantsCaption}</caption>
      <thead>
        <tr>
          <th scope="col" class="border-b-2 border-navy bg-ice px-3 py-3 text-left font-semibold text-navy">#</th>
          <th scope="col" class="border-b-2 border-navy bg-ice px-3 py-3 text-left font-semibold text-navy">{t(lang, 'name')}</th>
          <th scope="col" class="border-b-2 border-navy bg-ice px-3 py-3 text-left font-semibold text-navy">{labels.club}</th>
          <th scope="col" class="border-b-2 border-navy bg-ice px-3 py-3 text-left font-semibold text-navy">{t(lang, 'country')}</th>
          <th scope="col" class="border-b-2 border-navy bg-ice px-3 py-3 text-left font-semibold text-navy">{t(lang, 'wr')}</th>
          <th scope="col" class="border-b-2 border-navy bg-ice px-3 py-3 text-left font-semibold text-navy">{labels.points}</th>
        </tr>
      </thead>
      <tbody data-participant-rows>
        {
          isTeam
            ? players.flatMap((team, teamIndex) => {
                const names = legacyRoster(team.name);
                return [
                  <tr class="border-t-2 border-slate-400 bg-ice font-semibold">
                    <td class="border-b border-slate-200 px-3 py-3 tabular-nums">{teamIndex + 1}</td>
                    <td class="border-b border-slate-200 px-3 py-3">{labels.team} {teamIndex + 1}</td>
                    <td class="border-b border-slate-200 px-3 py-3"></td>
                    <td class="border-b border-slate-200 px-3 py-3"></td>
                    <td class="border-b border-slate-200 px-3 py-3"></td>
                    <td class="border-b border-slate-200 px-3 py-3 tabular-nums">{team.ranking_points ?? '–'}</td>
                  </tr>,
                  ...names.map((name, playerIndex) => (
                    <tr class="bg-white">
                      <td class="border-b border-slate-200 px-3 py-3"></td>
                      <td class="border-b border-slate-200 px-3 py-3 pl-6">
                        {name}
                        {playerIndex >= playersPerTeam! && <span class="ml-2 text-xs text-slate-500">({labels.substitute})</span>}
                      </td>
                      <td class="border-b border-slate-200 px-3 py-3"></td>
                      <td class="border-b border-slate-200 px-3 py-3"></td>
                      <td class="border-b border-slate-200 px-3 py-3"></td>
                      <td class="border-b border-slate-200 px-3 py-3 tabular-nums">–</td>
                    </tr>
                  )),
                ];
              })
            : players.map((player, index) => (
                <tr class="odd:bg-white even:bg-ice/50 hover:bg-ice">
                  <td class="border-b border-slate-200 px-3 py-3 tabular-nums">{index + 1}</td>
                  <td class="border-b border-slate-200 px-3 py-3 font-medium text-navy">{player.name}</td>
                  <td class="border-b border-slate-200 px-3 py-3">{player.club ?? ''}</td>
                  <td class="border-b border-slate-200 px-3 py-3">{player.country}</td>
                  <td class="border-b border-slate-200 px-3 py-3 tabular-nums">{player.world_ranking ?? '–'}</td>
                  <td class="border-b border-slate-200 px-3 py-3 tabular-nums">{player.ranking_points ?? '–'}</td>
                </tr>
              ))
        }
      </tbody>
    </table>
  </div>
  <div data-placement-points-wrap class="mt-10 hidden border-t border-slate-200 pt-8">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class="text-xl font-bold text-navy">{labels.placementHeading}</h3>
      <p data-ranking-level class="text-sm font-semibold text-slate-600"></p>
    </div>
    <p class="mt-2 max-w-3xl text-sm text-slate-600">{labels.calculationNote}</p>
    <p data-placement-note class="mt-2 text-sm font-semibold text-slate-700" aria-live="polite"></p>
    <div data-placement-table class="mt-4 border-y border-slate-200">
      <table class="w-full border-collapse text-sm">
        <caption class="sr-only">{labels.placementCaption}</caption>
        <thead>
          <tr>
            <th scope="col" class="border-b-2 border-navy bg-ice px-3 py-3 text-left font-semibold text-navy">{labels.placement}</th>
            <th scope="col" class="border-b-2 border-navy bg-ice px-3 py-3 text-left font-semibold text-navy">{labels.award}</th>
          </tr>
        </thead>
        <tbody data-placement-rows></tbody>
      </table>
    </div>
  </div>
</section>

<script>
  interface RosterPlayer {
    name: string;
    club: string | null;
    country: string | null;
    worldRanking: number | null;
    rankingPoints: number;
  }
  interface Participant {
    type: 'player' | 'team';
    name: string;
    club: string | null;
    country: string | null;
    world_ranking: number | null;
    ranking_points: number | null;
    roster: RosterPlayer[] | null;
  }
  interface ResponseBody {
    participants: Participant[];
    playersPerTeam: number | null;
    rankingRefreshedAt: string | null;
    rankingLevel: '1-world' | '1-continental' | '2' | '3' | '4' | '5' | '6' | '10' | null;
    rankingAlgorithm: 'ithf-wr-2020' | null;
    rankingValuesComplete: boolean;
    placementPoints: Array<{ placement: number; points: number }> | null;
  }

  const section = document.querySelector<HTMLElement>('[data-participants]');
  if (section) {
    const tbody = section.querySelector<HTMLTableSectionElement>('[data-participant-rows]')!;
    const mobile = section.querySelector<HTMLElement>('[data-participant-mobile]')!;
    const mobileRows = section.querySelector<HTMLOListElement>('[data-participant-mobile-rows]')!;
    const count = section.querySelector<HTMLElement>('[data-participant-count]')!;
    const table = section.querySelector<HTMLElement>('[data-participant-table]')!;
    const empty = section.querySelector<HTMLElement>('[data-participant-empty]')!;
    const refreshed = section.querySelector<HTMLElement>('[data-ranking-refreshed]');
    const status = section.querySelector<HTMLElement>('[data-participants-status]')!;
    const placementWrap = section.querySelector<HTMLElement>('[data-placement-points-wrap]')!;
    const placementRows = section.querySelector<HTMLTableSectionElement>('[data-placement-rows]')!;
    const placementTable = section.querySelector<HTMLElement>('[data-placement-table]')!;
    const placementNote = section.querySelector<HTMLElement>('[data-placement-note]')!;
    const rankingLevel = section.querySelector<HTMLElement>('[data-ranking-level]')!;
    const slug = section.dataset.slug!;
    const lang = section.dataset.lang === 'en' ? 'en' : 'no';
    const labels = JSON.parse(section.dataset.labels ?? '{}') as Record<string, string>;
    let hasLiveData = false;
    const levelLabels: Record<NonNullable<ResponseBody['rankingLevel']>, string> = lang === 'en'
      ? {
          '1-world': 'Level 1 · World Championship',
          '1-continental': 'Level 1 · Continental Championship',
          '2': 'Level 2', '3': 'Level 3', '4': 'Level 4', '5': 'Level 5', '6': 'Level 6',
          '10': 'Level 10 · Team competition',
        }
      : {
          '1-world': 'Nivå 1 · Verdensmesterskap',
          '1-continental': 'Nivå 1 · Kontinentalmesterskap',
          '2': 'Nivå 2', '3': 'Nivå 3', '4': 'Nivå 4', '5': 'Nivå 5', '6': 'Nivå 6',
          '10': 'Nivå 10 · Lagturnering',
        };

    function cell(text = '', classes = ''): HTMLTableCellElement {
      const td = document.createElement('td');
      td.className = `border-b border-slate-200 px-3 py-3 ${classes}`;
      td.textContent = text;
      return td;
    }

    function updateParticipantCount(participants: Participant[]) {
      count.textContent = `(${participants.length})`;
      table.classList.toggle('md:block', participants.length > 0);
      mobile.classList.toggle('hidden', participants.length === 0);
      empty.classList.toggle('hidden', participants.length > 0);
    }

    function mobileMeta(parts: Array<string | null | undefined>): HTMLParagraphElement {
      const meta = document.createElement('p');
      meta.className = 'mt-1 break-words text-xs leading-5 text-slate-600';
      meta.textContent = parts.filter(Boolean).join(' · ');
      return meta;
    }

    function renderIndividualMobile(participants: Participant[]): DocumentFragment {
      const frag = document.createDocumentFragment();
      participants.forEach((player, index) => {
        const li = document.createElement('li');
        li.className = 'grid grid-cols-[2rem_minmax(0,1fr)] gap-3 py-3';
        const number = document.createElement('span');
        number.className = 'pt-0.5 text-sm tabular-nums text-slate-500';
        number.ariaHidden = 'true';
        number.textContent = String(index + 1);
        const details = document.createElement('div');
        details.className = 'min-w-0';
        const name = document.createElement('p');
        name.className = 'font-medium text-navy';
        name.textContent = player.name;
        details.append(
          name,
          mobileMeta([
            player.club,
            player.country,
            `WR ${player.world_ranking ?? '–'}`,
            `${labels.points ?? 'Poeng'}: ${player.ranking_points ?? '–'}`,
          ]),
        );
        li.append(number, details);
        frag.appendChild(li);
      });
      return frag;
    }

    function renderTeamsMobile(participants: Participant[], playersPerTeam: number): DocumentFragment {
      const frag = document.createDocumentFragment();
      participants.forEach((team, teamIndex) => {
        const teamItem = document.createElement('li');
        teamItem.className = 'py-4';
        const header = document.createElement('div');
        header.className = 'flex items-baseline justify-between gap-4';
        const heading = document.createElement('h3');
        heading.className = 'font-semibold text-navy';
        heading.textContent = `${labels.team ?? 'Lag'} ${teamIndex + 1}`;
        const points = document.createElement('span');
        points.className = 'shrink-0 text-xs tabular-nums text-slate-600';
        points.textContent = `${labels.points ?? 'Poeng'}: ${team.ranking_points ?? 0}`;
        header.append(heading, points);

        const roster = document.createElement('ul');
        roster.className = 'mt-2 divide-y divide-slate-100';
        (team.roster ?? []).forEach((player, playerIndex) => {
          const playerItem = document.createElement('li');
          playerItem.className = 'py-2';
          const name = document.createElement('p');
          name.className = 'text-sm font-medium text-navy';
          name.textContent = player.name;
          if (playerIndex >= playersPerTeam) {
            const substitute = document.createElement('span');
            substitute.className = 'ml-2 text-xs font-normal text-slate-500';
            substitute.textContent = `(${labels.substitute ?? 'Innbytter'})`;
            name.appendChild(substitute);
          }
          playerItem.append(
            name,
            mobileMeta([
              player.club,
              player.country,
              `WR ${player.worldRanking ?? '–'}`,
              `${labels.points ?? 'Poeng'}: ${player.rankingPoints}`,
            ]),
          );
          roster.appendChild(playerItem);
        });
        teamItem.append(header, roster);
        frag.appendChild(teamItem);
      });
      return frag;
    }

    function renderIndividual(participants: Participant[]): DocumentFragment {
      const frag = document.createDocumentFragment();
      participants.forEach((player, index) => {
        const tr = document.createElement('tr');
        tr.className = 'odd:bg-white even:bg-ice/50 hover:bg-ice';
        tr.append(
          cell(String(index + 1), 'tabular-nums'),
          cell(player.name),
          cell(player.club ?? ''),
          cell(player.country ?? ''),
          cell(player.world_ranking == null ? '–' : String(player.world_ranking), 'tabular-nums'),
          cell(player.ranking_points == null ? '–' : String(player.ranking_points), 'tabular-nums'),
        );
        frag.appendChild(tr);
      });
      return frag;
    }

    function renderTeams(participants: Participant[], playersPerTeam: number): DocumentFragment {
      const frag = document.createDocumentFragment();
      participants.forEach((team, teamIndex) => {
        const summary = document.createElement('tr');
        summary.className = 'border-t-2 border-slate-400 bg-ice font-semibold';
        summary.append(
          cell(String(teamIndex + 1), 'tabular-nums'),
          cell(`${labels.team ?? 'Lag'} ${teamIndex + 1}`),
          cell(),
          cell(),
          cell(),
          cell(String(team.ranking_points ?? 0), 'tabular-nums'),
        );
        frag.appendChild(summary);
        (team.roster ?? []).forEach((player, playerIndex) => {
          const tr = document.createElement('tr');
          tr.className = 'bg-white';
          const name = cell(player.name, 'pl-6 font-medium text-navy');
          if (playerIndex >= playersPerTeam) {
            const substitute = document.createElement('span');
            substitute.className = 'ml-2 text-xs text-slate-500';
            substitute.textContent = `(${labels.substitute ?? 'Innbytter'})`;
            name.appendChild(substitute);
          }
          tr.append(
            cell(),
            name,
            cell(player.club ?? ''),
            cell(player.country ?? ''),
            cell(player.worldRanking == null ? '–' : String(player.worldRanking), 'tabular-nums'),
            cell(String(player.rankingPoints), 'tabular-nums'),
          );
          frag.appendChild(tr);
        });
      });
      return frag;
    }

    function renderPlacementPoints(data: ResponseBody) {
      if (data.rankingLevel == null || data.placementPoints == null) {
        placementWrap.classList.add('hidden');
        return;
      }
      placementWrap.classList.remove('hidden');
      rankingLevel.textContent = levelLabels[data.rankingLevel];
      placementRows.replaceChildren(...data.placementPoints.map((row) => {
        const tr = document.createElement('tr');
        tr.className = 'odd:bg-white even:bg-ice/50';
        tr.append(
          cell(String(row.placement), 'tabular-nums'),
          cell(String(row.points), 'tabular-nums font-semibold'),
        );
        return tr;
      }));
      placementTable.classList.toggle('hidden', data.placementPoints.length === 0);
      const notes: string[] = [];
      if (data.rankingLevel === '10') notes.push(labels.teamNoPoints ?? '');
      else if (data.placementPoints.length === 0) notes.push(labels.emptyPoints ?? '');
      else if (data.placementPoints.length < 4) notes.push(labels.fewerThanFour ?? '');
      if (!data.rankingValuesComplete) notes.push(labels.incomplete ?? '');
      placementNote.textContent = notes.filter(Boolean).join(' ');
      placementNote.classList.toggle('hidden', notes.length === 0);
    }

    async function refresh() {
      const showUnavailable = () => {
        status.textContent = hasLiveData
          ? (labels.liveUnavailable ?? '')
          : (labels.snapshotFallback ?? labels.liveUnavailable ?? '');
        status.classList.remove('hidden');
      };
      try {
        const res = await fetch(`/api/tournaments/${encodeURIComponent(slug)}/players`);
        if (!res.ok) {
          showUnavailable();
          return;
        }
        const data = (await res.json()) as ResponseBody;
        tbody.replaceChildren(
          data.playersPerTeam == null
            ? renderIndividual(data.participants)
            : renderTeams(data.participants, data.playersPerTeam),
        );
        mobileRows.replaceChildren(
          data.playersPerTeam == null
            ? renderIndividualMobile(data.participants)
            : renderTeamsMobile(data.participants, data.playersPerTeam),
        );
        updateParticipantCount(data.participants);
        if (refreshed && data.rankingRefreshedAt) {
          const date = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'nb-NO', {
            timeZone: 'Europe/Oslo',
            dateStyle: 'medium',
            timeStyle: 'short',
          }).format(new Date(data.rankingRefreshedAt));
          refreshed.textContent = `${labels.refreshed ?? 'Ranking oppdatert'} ${date}`;
        }
        renderPlacementPoints(data);
        hasLiveData = true;
        status.textContent = '';
        status.classList.add('hidden');
      } catch {
        showUnavailable();
      }
    }

    void refresh();
    document.addEventListener('registrations:refresh', () => void refresh());
  }
</script>
