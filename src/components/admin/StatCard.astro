---
interface Props {
  /** Big number — string because it may be a live placeholder. */
  value: string;
  label: string;
  /** Small hint under the label. */
  hint?: string;
  /** Optional hook for updating the hint when live data becomes available. */
  hintId?: string;
  /** Heroicon (outline) path data. */
  icon: string;
  /** data-* attributes are spread onto the value element by the caller via id. */
  valueId?: string;
}

const { value, label, hint, hintId, icon, valueId } = Astro.props;
---

<div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p
        class="font-display text-3xl font-extrabold tabular-nums text-navy dark:text-white"
        {...(valueId ? { 'data-stat': valueId } : {})}
      >
        {value}
      </p>
      <p class="mt-1 text-sm font-semibold text-slate-600 dark:text-slate-300">{label}</p>
      {hint && <p class="mt-0.5 text-xs text-slate-600 dark:text-slate-400" {...(hintId ? { 'data-stat-hint': hintId } : {})}>{hint}</p>}
    </div>
    <span class="rounded-lg bg-ice p-2 text-navy dark:bg-slate-800 dark:text-slate-300">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={icon} /></svg>
    </span>
  </div>
</div>
