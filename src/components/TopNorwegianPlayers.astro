---
import ranking from '../data/ranking.json';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

type RankingRow = [
  worldRank: number,
  playerId: number,
  name: string,
  club: string,
  nation: string,
  points: number,
  playerValue: number,
];

const { lang } = Astro.props;
const players = (ranking as unknown as RankingRow[])
  .filter((row) => row[4] === 'NOR')
  .sort((a, b) => a[0] - b[0])
  .slice(0, 10);

const portraitsByPlayerId: Record<number, string> = {
  660648: '/media/images/index-4cc0ec37.webp',
  668143: '/media/images/index-b7d657df.webp',
  660870: '/media/images/index-8730af0c.webp',
  660869: '/media/images/index-d5bf3d3e.jpg',
  220035: '/media/images/index-18d51b20.jpg',
  659341: '/media/images/index-82b9f188.webp',
  660637: '/media/galleries/vm-2023/thumbs/92733346.jpg',
  220135: '/media/images/om-oss-be83385b-400.webp',
  220019: '/media/galleries/norway-open-2024/thumbs/2b91ed85.jpg',
  220094: '/media/galleries/vm-2023/thumbs/7bbd7fcc.jpg',
  670684: '/media/galleries/norway-open-2025/thumbs/35c6fdae.jpg',
};

const topAlignedPortraitIds = new Set([668143, 660870, 659341, 220019, 670684]);

const getInitials = (name: string) => {
  const parts = name.trim().split(/\s+/);
  return `${parts[0]?.[0] ?? ''}${parts.length > 1 ? parts.at(-1)?.[0] ?? '' : ''}`.toUpperCase();
};

if (players.length < 10) {
  throw new Error(`Ranking snapshot contains only ${players.length} Norwegian players; expected at least 10`);
}

const numberLocale = lang === 'en' ? 'en-GB' : 'nb-NO';
const l = lang === 'en'
  ? {
      heading: 'Top 10 Norwegian players',
      norwayRank: 'Norway rank',
      player: 'Player',
      worldRank: 'World ranking',
      points: 'Points',
      fullRanking: 'View the full ITHF ranking',
      caption: 'The ten highest-ranked Norwegian players in the ITHF world ranking',
    }
  : {
      heading: 'Topp 10 norske spillere',
      norwayRank: 'Norgesplass',
      player: 'Spiller',
      worldRank: 'Verdensranking',
      points: 'Poeng',
      fullRanking: 'Se hele ITHF-rankingen',
      caption: 'De ti høyest rangerte norske spillerne på ITHFs verdensranking',
    };
---

<section aria-labelledby="top-norwegian-players" class="mx-auto max-w-6xl px-4 py-10">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="top-norwegian-players" class="text-2xl font-bold text-navy">{l.heading}</h2>
    <a
      href="https://stiga.trefik.cz/ithf/ranking/index.aspx"
      class="inline-flex min-h-11 items-center text-sm font-semibold text-brand no-underline hover:underline"
    >
      {l.fullRanking}
    </a>
  </div>

  <div class="scroll-region mt-4 border-y border-slate-200" role="region" aria-label={l.caption} tabindex="0">
    <table class="w-full min-w-[40rem] border-collapse text-left">
      <caption class="sr-only">{l.caption}</caption>
      <thead class="border-b border-slate-200 text-sm text-slate-600">
        <tr>
          <th scope="col" class="w-28 px-2 py-3 font-semibold sm:px-3">{l.norwayRank}</th>
          <th scope="col" class="px-2 py-3 font-semibold sm:px-3">{l.player}</th>
          <th scope="col" class="px-2 py-3 text-right font-semibold sm:px-3">{l.worldRank}</th>
          <th scope="col" class="px-2 py-3 text-right font-semibold sm:px-3">{l.points}</th>
        </tr>
      </thead>
      <tbody>
        {
          players.map(([worldRank, playerId, name, club, , points], index) => {
            const profileUrl = `https://stiga.trefik.cz/ithf/ranking/player.aspx?id=${playerId}`;
            const portrait = portraitsByPlayerId[playerId];

            return (
              <tr class="border-b border-slate-100 last:border-b-0">
                <td class="px-2 py-3 font-semibold tabular-nums text-navy sm:px-3">{index + 1}</td>
                <th scope="row" class="px-2 py-2 sm:px-3">
                  <a href={profileUrl} class="group flex items-center gap-3 no-underline">
                    {
                      portrait ? (
                        <img
                          src={portrait}
                          alt=""
                          width="56"
                          height="56"
                          loading="lazy"
                          decoding="async"
                          style={topAlignedPortraitIds.has(playerId) ? 'object-position: center top' : undefined}
                          class="h-14 w-14 shrink-0 rounded-full object-cover ring-1 ring-slate-200"
                        />
                      ) : (
                        <span
                          aria-hidden="true"
                          class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-navy ring-1 ring-slate-200"
                        >
                          {getInitials(name)}
                        </span>
                      )
                    }
                    <span class="min-w-0">
                      <span class="block font-semibold text-navy group-hover:text-brand group-hover:underline">
                        {name}
                      </span>
                      {club && <span class="mt-0.5 block text-sm font-normal text-slate-500">{club}</span>}
                    </span>
                  </a>
                </th>
                <td class="px-2 py-3 text-right tabular-nums text-slate-700 sm:px-3">
                  {worldRank.toLocaleString(numberLocale)}
                </td>
                <td class="px-2 py-3 text-right tabular-nums text-slate-700 sm:px-3">
                  {points.toLocaleString(numberLocale)}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</section>
