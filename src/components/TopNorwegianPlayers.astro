---
import ranking from '../data/ranking.json';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

type RankingRow = [
  worldRank: number,
  playerId: number,
  name: string,
  club: string,
  nation: string,
  points: number,
  playerValue: number,
];

const { lang } = Astro.props;
const players = (ranking as unknown as RankingRow[])
  .filter((row) => row[4] === 'NOR')
  .sort((a, b) => a[0] - b[0])
  .slice(0, 10);

if (players.length < 10) {
  throw new Error(`Ranking snapshot contains only ${players.length} Norwegian players; expected at least 10`);
}

const numberLocale = lang === 'en' ? 'en-GB' : 'nb-NO';
const l = lang === 'en'
  ? {
      heading: 'Top 10 Norwegian players',
      norwayRank: 'Norway rank',
      player: 'Player',
      worldRank: 'World ranking',
      points: 'Points',
      fullRanking: 'View the full ITHF ranking',
      caption: 'The ten highest-ranked Norwegian players in the ITHF world ranking',
    }
  : {
      heading: 'Topp 10 norske spillere',
      norwayRank: 'Norgesplass',
      player: 'Spiller',
      worldRank: 'Verdensranking',
      points: 'Poeng',
      fullRanking: 'Se hele ITHF-rankingen',
      caption: 'De ti høyest rangerte norske spillerne på ITHFs verdensranking',
    };
---

<section aria-labelledby="top-norwegian-players" class="mx-auto max-w-6xl px-4 py-10">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="top-norwegian-players" class="text-2xl font-bold text-navy">{l.heading}</h2>
    <a
      href="https://stiga.trefik.cz/ithf/ranking/index.aspx"
      class="text-sm font-semibold text-brand no-underline hover:underline"
    >
      {l.fullRanking}
    </a>
  </div>

  <div class="mt-4 overflow-x-auto border-y border-slate-200">
    <table class="w-full min-w-[36rem] border-collapse text-left">
      <caption class="sr-only">{l.caption}</caption>
      <thead class="border-b border-slate-200 text-sm text-slate-600">
        <tr>
          <th scope="col" class="w-28 px-2 py-3 font-semibold sm:px-3">{l.norwayRank}</th>
          <th scope="col" class="px-2 py-3 font-semibold sm:px-3">{l.player}</th>
          <th scope="col" class="px-2 py-3 text-right font-semibold sm:px-3">{l.worldRank}</th>
          <th scope="col" class="px-2 py-3 text-right font-semibold sm:px-3">{l.points}</th>
        </tr>
      </thead>
      <tbody>
        {
          players.map(([worldRank, , name, club, , points], index) => (
            <tr class="border-b border-slate-100 last:border-b-0">
              <td class="px-2 py-3 font-semibold tabular-nums text-navy sm:px-3">{index + 1}</td>
              <th scope="row" class="px-2 py-3 font-semibold text-navy sm:px-3">
                <span class="block">{name}</span>
                {club && <span class="mt-0.5 block text-sm font-normal text-slate-500">{club}</span>}
              </th>
              <td class="px-2 py-3 text-right tabular-nums text-slate-700 sm:px-3">
                {worldRank.toLocaleString(numberLocale)}
              </td>
              <td class="px-2 py-3 text-right tabular-nums text-slate-700 sm:px-3">
                {points.toLocaleString(numberLocale)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
