---
import { getTournamentsSorted } from '../lib/content';
import { tournamentDayStatus } from '../lib/dates';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const now = new Date();
// Keep every configured event in the HTML so an older static build can activate it.
const tournaments = (await getTournamentsSorted(now, lang))
  .filter((tournament) => tournament.entry.data.results)
  .map((tournament) => ({
    name: tournament.name,
    date: tournament.entry.data.date,
    url: `https://th.sportscorpion.com/eng/tournament/id/${tournament.entry.data.results!.tournamentId}/`,
    ongoing: tournamentDayStatus(tournament.entry.data.date, now) === 'ongoing',
  }));
---

{
  tournaments.length > 0 && (
    <section
      data-live-banner
      hidden={!tournaments.some((tournament) => tournament.ongoing)}
      aria-label={t(lang, 'ongoingTournaments')}
      aria-live="polite"
      class="bg-navy text-white"
    >
      {tournaments.map((tournament) => (
        <div data-live-tournament data-tournament-date={tournament.date} hidden={!tournament.ongoing}>
          <div class="mx-auto flex max-w-6xl flex-col items-start gap-2 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
              <p class="inline-flex items-center gap-2 text-sm font-semibold">
                <span class="h-2 w-2 shrink-0 rounded-full bg-green-400" aria-hidden="true"></span>
                {t(lang, 'ongoing')}
              </p>
              <h2 class="text-lg font-bold text-white sm:text-xl">{tournament.name}</h2>
            </div>
            <a
              href={tournament.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 shrink-0 items-center gap-2 font-semibold text-white underline underline-offset-4 hover:decoration-2"
            >
              {t(lang, 'followLiveResults')}
              <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 shrink-0 fill-none stroke-current" stroke-width="1.8">
                <path d="M7 5h8v8M15 5 5 15" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span class="sr-only">{t(lang, 'opensInNewTab')}</span>
            </a>
          </div>
        </div>
      ))}
    </section>
  )
}

<script>
  import { tournamentDayStatus } from '../lib/dates';

  const banner = document.querySelector<HTMLElement>('[data-live-banner]');
  if (banner) {
    const tournaments = banner.querySelectorAll<HTMLElement>('[data-live-tournament]');
    const updateBanner = () => {
      const now = new Date();
      let hasOngoingTournament = false;
      for (const tournament of tournaments) {
        const ongoing = tournamentDayStatus(tournament.dataset.tournamentDate ?? '', now) === 'ongoing';
        tournament.hidden = !ongoing;
        hasOngoingTournament ||= ongoing;
      }
      banner.hidden = !hasOngoingTournament;
    };

    updateBanner();
    window.setInterval(updateBanner, 60_000);
    window.addEventListener('pageshow', updateBanner);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) updateBanner();
    });
  }
</script>
