---
import type { Lang } from '../lib/i18n';
import type { IllustrationEntry } from '../lib/illustrations';
import { illustrationMarkup } from '../lib/illustration-renderer';

interface Props {
  entry: IllustrationEntry;
  name: string;
  lang: Lang;
  decorative?: boolean;
  variant?: 'detail' | 'thumbnail';
  class?: string;
}

const {
  entry,
  name,
  lang,
  decorative = false,
  variant = 'detail',
  class: className = '',
} = Astro.props;
const { viewport, paths, slug } = entry.data;
const titleId = `illustration-${slug}-title`;
const descriptionId = `illustration-${slug}-description`;
const title = lang === 'en' ? `Movement illustration: ${name}` : `Bevegelsesillustrasjon: ${name}`;
const description = lang === 'en'
  ? `Table hockey players and numbered arrows show ${paths.length} movement steps on the rink.`
  : `Bordhockeyspillere og nummererte piler viser ${paths.length} bevegelsessteg på banen.`;
---

<svg
  viewBox={`${viewport.x} ${viewport.y} ${viewport.width} ${viewport.height}`}
  class:list={['block h-auto w-full bg-[#526f78]', className]}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-labelledby={decorative ? undefined : `${titleId} ${descriptionId}`}
  focusable="false"
  preserveAspectRatio="xMidYMid meet"
>
  {!decorative && <title id={titleId}>{title}</title>}
  {!decorative && <desc id={descriptionId}>{description}</desc>}
  <Fragment set:html={illustrationMarkup(entry.data, `illustration-${slug}`, variant === 'thumbnail')} />
</svg>
