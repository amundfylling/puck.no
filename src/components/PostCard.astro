---
import { formatDate } from '../lib/dates';
import { categorySlug } from '../lib/content';
import { getPublicImageDimensions } from '../lib/media';
import type { Post } from '../lib/content';
import type { Lang } from '../lib/i18n';

interface Props {
  post: Post;
  lang: Lang;
  /** Above-the-fold images (e.g. first cards) can load eagerly. */
  eager?: boolean;
  /** Large horizontal lead card for the newest post. */
  featured?: boolean;
  /** Blog indexes use h2; homepage cards sit below a section h2 and use h3. */
  headingLevel?: 2 | 3;
}

const { post, lang, eager = false, featured = false, headingLevel = 3 } = Astro.props;
const href = `${lang === 'en' ? '/en' : ''}/post/${post.data.slug}/`;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const coverDimensions = await getPublicImageDimensions(post.data.cover);
// No card boxes or pills: photo, meta, title, excerpt, categories as text (design rules 1 and 6).
---

<article
  class:list={[
    'group',
    featured ? 'grid gap-5 border-b border-slate-200 pb-8 sm:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] sm:items-center sm:gap-8' : 'flex flex-col',
  ]}
>
  {post.data.cover && (
    <a href={href} tabindex="-1" aria-hidden="true" class="block overflow-hidden rounded-lg">
      <img
        src={post.data.cover}
        alt=""
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : undefined}
        width={coverDimensions?.width}
        height={coverDimensions?.height}
        class="aspect-video w-full object-cover"
      />
    </a>
  )}
  <div class:list={['flex flex-1 flex-col', !featured && post.data.cover && 'mt-4']}>
    <p class="text-sm text-slate-600">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
      <span aria-hidden="true"> · </span>{post.data.author}
    </p>
    <Heading class:list={['mt-1 font-bold leading-snug', featured ? 'text-2xl sm:text-3xl' : 'text-lg']}>
      <a href={href} class="text-navy no-underline group-hover:text-brand hover:underline">{post.data.title}</a>
    </Heading>
    {post.data.description && (
      <p class:list={['mt-2 line-clamp-3 text-slate-600', !featured && 'text-sm']}>{post.data.description}</p>
    )}
    {post.data.categories.length > 0 && (
      <ul class="mt-1 flex flex-wrap gap-x-3" aria-label={lang === 'en' ? 'Categories' : 'Kategorier'}>
        {post.data.categories.map((cat) => (
          <li>
            <a
              href={`${lang === 'en' ? '/en' : ''}/blog/categories/${categorySlug(cat)}/`}
              class="inline-flex min-h-11 items-center text-sm font-semibold text-navy no-underline hover:text-brand hover:underline"
            >
              {cat}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
