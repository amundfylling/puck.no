---
import { formatDate } from '../lib/dates';
import { categorySlug } from '../lib/content';
import { getPublicImageDimensions } from '../lib/media';
import type { Post } from '../lib/content';
import type { Lang } from '../lib/i18n';

interface Props {
  post: Post;
  lang: Lang;
  /** Above-the-fold images (e.g. first cards) can load eagerly. */
  eager?: boolean;
  /** Large horizontal lead card for the newest post. */
  featured?: boolean;
  /** Blog indexes use h2; homepage cards sit below a section h2 and use h3. */
  headingLevel?: 2 | 3;
}

const { post, lang, eager = false, featured = false, headingLevel = 3 } = Astro.props;
const href = `${lang === 'en' ? '/en' : ''}/post/${post.data.slug}/`;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const coverDimensions = await getPublicImageDimensions(post.data.cover);
---

{
  featured ? (
    <article class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md sm:flex-row">
      {post.data.cover && (
        <div class="overflow-hidden sm:w-3/5">
          <img
            src={post.data.cover}
            alt=""
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={eager ? 'high' : undefined}
            width={coverDimensions?.width}
            height={coverDimensions?.height}
            class="aspect-video h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
      )}
      <div class="flex flex-1 flex-col justify-center p-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
        </p>
        <Heading class="mt-1.5 text-2xl font-bold leading-snug">
          <a href={href} class="text-navy no-underline hover:text-brand">{post.data.title}</a>
        </Heading>
        {post.data.description && (
          <p class="mt-2 line-clamp-3 text-slate-600">{post.data.description}</p>
        )}
        {post.data.categories.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2" aria-label={lang === 'en' ? 'Categories' : 'Kategorier'}>
            {post.data.categories.map((cat) => (
              <li>
                <a
                  href={`${lang === 'en' ? '/en' : ''}/blog/categories/${categorySlug(cat)}/`}
                  class="rounded-full bg-ice px-2.5 py-0.5 text-xs font-semibold text-navy no-underline hover:bg-navy hover:text-white"
                >
                  {cat}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </article>
  ) : (
    <article class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md">
      {post.data.cover && (
        <div class="overflow-hidden">
          <img
            src={post.data.cover}
            alt=""
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={eager ? 'high' : undefined}
            width={coverDimensions?.width}
            height={coverDimensions?.height}
            class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
      )}
      <div class="flex flex-1 flex-col p-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
        </p>
        <Heading class="mt-1 text-lg font-bold leading-snug">
          <a href={href} class="text-navy no-underline hover:text-brand">{post.data.title}</a>
        </Heading>
        {post.data.description && <p class="mt-2 line-clamp-3 text-sm text-slate-600">{post.data.description}</p>}
        {post.data.categories.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2" aria-label={lang === 'en' ? 'Categories' : 'Kategorier'}>
            {post.data.categories.map((cat) => (
              <li>
                <a
                  href={`${lang === 'en' ? '/en' : ''}/blog/categories/${categorySlug(cat)}/`}
                  class="rounded-full bg-ice px-2.5 py-0.5 text-xs font-semibold text-navy no-underline hover:bg-navy hover:text-white"
                >
                  {cat}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </article>
  )
}
