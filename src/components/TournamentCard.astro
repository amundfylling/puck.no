---
import { t, type Lang } from '../lib/i18n';
import { formatNoDate } from '../lib/dates';
import type { TournamentView } from '../lib/content';
import { getPublicImageDimensions } from '../lib/media';

interface Props {
  view: TournamentView;
  lang: Lang;
  /** Large hero-style card (next tournament). */
  featured?: boolean;
}

const { view, lang, featured = false } = Astro.props;
const { entry, status, image } = view;
const href = lang === 'en' ? `/en/turneringer/${entry.data.slug}/` : `/turneringer/${entry.data.slug}/`;
const dateLabel = formatNoDate(entry.data.date, lang);
const isoDate = view.date?.toISOString().slice(0, 10);
const imageDimensions = await getPublicImageDimensions(image);
---

{
  featured ? (
    <a
      href={href}
      class="group grid gap-5 border-b border-slate-200 py-5 no-underline first:pt-0 sm:grid-cols-[18rem_minmax(0,1fr)] sm:items-center sm:gap-8 lg:grid-cols-[24rem_minmax(0,1fr)]"
    >
      {image && (
        <img
          src={image}
          alt=""
          loading="lazy"
          decoding="async"
          width={imageDimensions?.width}
          height={imageDimensions?.height}
          class="aspect-[16/10] w-full rounded-lg object-cover"
        />
      )}
      <div class="min-w-0">
        <p class="flex items-center gap-2 text-sm font-semibold text-slate-600">
          <span
            class:list={[
              'h-2 w-2 rounded-full',
              status === 'upcoming' ? 'bg-green-500' : 'bg-slate-400',
            ]}
            aria-hidden="true"
          />
          {t(lang, status)}
        </p>
        <h3 class="mt-2 text-2xl font-bold text-navy group-hover:underline sm:text-3xl">{view.name}</h3>
        <p class="mt-3 flex flex-col gap-1 text-sm text-slate-600">
          <time datetime={isoDate} class="font-semibold text-navy">{dateLabel}</time>
          {entry.data.location && <span>{entry.data.location}</span>}
        </p>
        <p class="mt-5 inline-flex min-h-11 items-center gap-2 font-semibold text-brand">
          {t(lang, 'viewTournament')}
          <span aria-hidden="true">&rarr;</span>
        </p>
      </div>
    </a>
  ) : (
    <a
      href={href}
      class="group grid min-h-16 grid-cols-[4.5rem_minmax(0,1fr)_auto] items-center gap-4 py-3 no-underline hover:bg-ice/50"
    >
      {image && (
        <img
          src={image}
          alt=""
          loading="lazy"
          decoding="async"
          width={imageDimensions?.width}
          height={imageDimensions?.height}
          class="h-14 w-[4.5rem] rounded object-cover"
        />
      )}
      <div class:list={['min-w-0', !image && 'col-span-2']}>
        <h3 class="font-semibold leading-snug text-navy group-hover:underline">{view.name}</h3>
        <p class="mt-1 flex flex-wrap gap-x-2 text-sm text-slate-600">
          <time datetime={isoDate} class="tabular-nums">{dateLabel}</time>
          {entry.data.location && (
            <>
              <span aria-hidden="true">·</span>
              <span>{entry.data.location}</span>
            </>
          )}
        </p>
      </div>
      <span aria-hidden="true" class="text-lg text-slate-400 group-hover:text-navy">&rarr;</span>
    </a>
  )
}
