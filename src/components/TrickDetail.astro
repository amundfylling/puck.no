---
import type { Lang } from '../lib/i18n';
import { getPublicImageDimensions } from '../lib/media';
import type { IllustrationEntry } from '../lib/illustrations';
import TrickIllustration from './TrickIllustration.astro';
import {
  cataloguePath,
  playerLabels,
  relatedTricks,
  trickPath,
  type TrickEntry,
} from '../lib/tricks';

interface Props {
  entry: TrickEntry;
  entries: TrickEntry[];
  illustration?: IllustrationEntry;
  lang: Lang;
}

const { entry, entries, illustration, lang } = Astro.props;
const { data } = entry;
const related = relatedTricks(entry, entries);
const imageDimensions = illustration ? null : await getPublicImageDimensions(data.diagram);
const copy = lang === 'en'
  ? {
      back: 'All combinations',
      player: 'Player',
      difficulty: 'Difficulty',
      instructions: 'How it works',
      illustration: 'Movement illustration',
      video: 'Watch video',
      missingMedia: 'This combination does not have an illustration or video yet.',
      related: 'Practise next',
      open: 'Open combination',
      aliases: 'Also known as',
    }
  : {
      back: 'Alle kombinasjoner',
      player: 'Spiller',
      difficulty: 'Vanskelighetsgrad',
      instructions: 'Slik utføres den',
      illustration: 'Bevegelsesillustrasjon',
      video: 'Se video',
      missingMedia: 'Denne kombinasjonen har ikke illustrasjon eller video ennå.',
      related: 'Øv på disse etterpå',
      open: 'Åpne kombinasjon',
      aliases: 'Også kjent som',
    };
---

<article class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
  <nav aria-label={lang === 'en' ? 'Breadcrumb' : 'Brødsmulesti'}>
    <a href={cataloguePath(lang)} class="inline-flex min-h-11 items-center gap-2 font-semibold text-brand no-underline hover:underline">
      <span aria-hidden="true">←</span>{copy.back}
    </a>
  </nav>

  <header class="mt-3 border-b border-slate-200 pb-7 sm:pb-9">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm font-semibold text-slate-600">
      <span>{copy.player}: {data.players.map((player) => playerLabels[player][lang]).join(' · ')}</span>
      <span aria-hidden="true">·</span>
      <span>{copy.difficulty}:<strong class="ml-1 text-navy">{data.difficulty}/10</strong></span>
    </p>
    <h1 class="mt-3 max-w-4xl text-4xl font-extrabold text-navy sm:text-5xl lg:text-6xl">{data.name}</h1>
    {data.aliases.length > 0 && <p class="mt-3 text-slate-600">{copy.aliases}: {data.aliases.join(', ')}</p>}
  </header>

  <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,27rem)] lg:gap-16">
    <section aria-labelledby="instructions-title">
      <h2 id="instructions-title" class="text-2xl font-bold text-navy">{copy.instructions}</h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-700">{data.description[lang]}</p>
      {data.videoUrl && (
        <p class="mt-7">
          <a href={data.videoUrl} class="btn-outline" rel="noopener noreferrer">{copy.video}<span aria-hidden="true" class="ml-2">↗</span></a>
        </p>
      )}
      {!illustration && !data.diagram && !data.videoUrl && (
        <p class="mt-7 border-l-4 border-brand bg-ice px-4 py-3 text-sm text-slate-700">{copy.missingMedia}</p>
      )}
    </section>

    {(illustration || data.diagram) && (
      <figure class="border-t border-slate-200 pt-6 lg:border-t-0 lg:pt-0">
        <figcaption class="mb-3 text-sm font-semibold text-navy">{copy.illustration}</figcaption>
        {illustration ? (
          <TrickIllustration
            entry={illustration}
            name={data.name}
            lang={lang}
            class="rounded-lg border border-slate-200"
          />
        ) : (
          <img
            src={data.diagram}
            alt={`${copy.illustration}: ${data.name}`}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width={imageDimensions?.width}
            height={imageDimensions?.height}
            class="h-auto w-full rounded-lg border border-slate-200 bg-white"
          />
        )}
      </figure>
    )}
  </div>

  <section aria-labelledby="related-title" class="mt-12 border-t border-slate-200 pt-8 sm:mt-16">
    <h2 id="related-title" class="text-2xl font-bold text-navy">{copy.related}</h2>
    <div class="mt-4 grid border-t border-slate-200 md:grid-cols-3 md:divide-x md:divide-slate-200">
      {related.map((item) => (
        <a href={trickPath(item.data.slug, lang)} class="group flex min-h-36 flex-col justify-between border-b border-slate-200 py-5 no-underline md:px-5 md:first:pl-0 md:last:pr-0">
          <div>
            <p class="text-sm text-slate-600">{playerLabels[item.data.players[0]][lang]} · {lang === 'en' ? 'Level' : 'Grad'} {item.data.difficulty}</p>
            <h3 class="mt-2 text-lg font-bold text-navy group-hover:underline">{item.data.name}</h3>
          </div>
          <p class="mt-4 text-sm font-semibold text-brand">{copy.open}<span aria-hidden="true" class="ml-2">→</span></p>
        </a>
      ))}
    </div>
  </section>
</article>
