---
import { t, type Lang } from '../lib/i18n';
import { groupByParent, type TournamentView } from '../lib/content';
import { formatNoDate } from '../lib/dates';
import TournamentCard from './TournamentCard.astro';

interface Props {
  lang: Lang;
  views: TournamentView[];
}

const { lang, views } = Astro.props;
const upcoming = views.filter((v) => v.status === 'upcoming');
const past = views.filter((v) => v.status === 'past');

const allSlugs = new Set(views.map((v) => v.entry.data.slug));
const upcomingFamilies = groupByParent(upcoming, allSlugs);
const pastFamilies = groupByParent(past, allSlugs);
---

<section class="mx-auto max-w-4xl px-4 py-10">
  <h1 class="text-3xl font-extrabold text-navy">{lang === 'en' ? 'Tournaments' : 'Turneringer'}</h1>

  <div class="mt-8 flex items-baseline gap-3">
    <h2 class="text-xl font-bold text-navy">{t(lang, 'upcomingTournaments')}</h2>
    <span class="text-sm text-slate-500">({upcoming.length})</span>
  </div>
  <div class="mt-4">
    {
      upcomingFamilies.length > 0 ? (
        <div class="space-y-4">
          {upcomingFamilies.map((family) => (
            <div>
              <TournamentCard view={family.main} lang={lang} featured />
              {family.children.map((item) => (
                <a
                  href={lang === 'en' ? `/en/turneringer/${item.entry.data.slug}/` : `/turneringer/${item.entry.data.slug}/`}
                  class="group flex items-baseline gap-3 border-b border-slate-100 py-2 pl-4 no-underline last:border-b-0 hover:bg-ice/50"
                >
                  <span class="grow text-[15px] text-navy">
                    <span class="mr-1.5 text-slate-400" aria-hidden="true">↳</span>
                    <span class="group-hover:underline">{item.name}</span>
                  </span>
                  <span class="shrink-0 text-[13px] tabular-nums text-slate-500">
                    {formatNoDate(item.entry.data.date, lang)}
                  </span>
                </a>
              ))}
            </div>
          ))}
        </div>
      ) : (
        <p class="rounded-lg border border-dashed border-slate-300 p-4 text-sm text-slate-500">
          {t(lang, 'noUpcomingTournaments')}
        </p>
      )
    }
  </div>

  <div class="mt-10 flex items-baseline gap-3">
    <h2 class="text-xl font-bold text-navy">{t(lang, 'pastTournaments')}</h2>
    <span class="text-sm text-slate-500">({past.length})</span>
  </div>
  <div class="mt-4 divide-y divide-slate-200 border-y border-slate-200">
    {pastFamilies.map((family) => (
      <div>
        <TournamentCard view={family.main} lang={lang} />
        {family.children.map((item) => (
          <a
            href={lang === 'en' ? `/en/turneringer/${item.entry.data.slug}/` : `/turneringer/${item.entry.data.slug}/`}
            class="group flex items-baseline gap-3 border-b border-slate-100 py-2 pl-20 no-underline last:border-b-0 hover:bg-ice/50"
          >
            <span class="grow text-[15px] text-navy">
              <span class="mr-1.5 text-slate-400" aria-hidden="true">↳</span>
              <span class="group-hover:underline">{item.name}</span>
            </span>
            <span class="shrink-0 text-[13px] tabular-nums text-slate-500">
              {formatNoDate(item.entry.data.date, lang)}
            </span>
          </a>
        ))}
      </div>
    ))}
  </div>
</section>
