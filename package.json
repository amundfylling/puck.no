{
  "name": "puck-no",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/add-csp-hashes.mjs && node scripts/generate-agent-markdown.mjs",
    "prebuild": "node scripts/gen-agent-skills-index.mjs && node scripts/check-illustrations.mjs && node scripts/gen-tournament-config.mjs && node scripts/fetch-ranking.mjs && node scripts/fetch-qualification.mjs && node scripts/optimize-media.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check-links": "node scripts/check-links.mjs",
    "check:illustrations": "node scripts/check-illustrations.mjs",
    "illustration:draft": "node scripts/create-illustration-draft.mjs",
    "illustration:migrate": "node scripts/migrate-legacy-illustrations.mjs",
    "audit-generated": "node scripts/audit-generated.mjs",
    "generate:cloudflare-types": "wrangler types functions/worker-configuration.d.ts --env-interface CloudflareEnv --include-runtime false",
    "check:cloudflare-types": "wrangler types functions/worker-configuration.d.ts --env-interface CloudflareEnv --include-runtime false --check",
    "test": "node --test functions/lib/*.test.ts scripts/lib/*.test.mjs scripts/seed-d1.test.mjs",
    "backfill-ranking": "node scripts/backfill-ranking-values.mjs",
    "refresh-qualification": "QUALIFICATION_FORCE_REFRESH=1 node scripts/fetch-qualification.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "jose": "^6.2.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/markdown-satteri": "^0.3.4",
    "@cloudflare/workers-types": "^5.20260813.1",
    "marked": "^18.0.6",
    "turndown": "^7.2.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.122.0"
  }
}
